# MEDIA_STORAGE=local (default) or r2
MEDIA_STORAGE=local

# Optional: enables Google Analytics 4 page views and audio events.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Required only when MEDIA_STORAGE=r2. Keep real values in .env.local, never commit them.
R2_ACCOUNT_ID=
R2_BUCKET=gamma-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
